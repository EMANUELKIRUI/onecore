NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Replace with the non-owner, NOBYPASSRLS local application database URL.
DATABASE_URL=postgresql://onecore_app:CHANGE_ME@127.0.0.1:5432/onecore_dev
# Migration commands use a separate onecore_migrator URL supplied securely
# from the approved secret manager or protected shell; npm does not load .env.
# Never store a real migration URL or credential in this file.
MIGRATOR_DATABASE_URL=
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000
BUSINESS_APP_ORIGIN=https://business.example.com
AUTH_SESSION_TTL_SECONDS=43200
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
# Temporary local development convenience; staging and production reject disabled MFA.
AUTH_MFA_ENFORCEMENT=disabled
# Use a random 32-byte-or-longer key from a secret manager for MFA.
MFA_ENCRYPTION_KEY=replace-with-a-32-byte-or-longer-secret-key
# Verify the sender domain in Resend before using this address for delivery.
RESEND_API_KEY=re_replace_with_your_resend_key
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_BASE_URL=https://api.resend.com/emails